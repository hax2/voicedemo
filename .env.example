# Optional: HuggingFace access token (required for gated SPRINGLab/EZ-VC checkpoints)
HF_TOKEN=

# Optional: Google Cloud TTS API Key (only needed if regenerating reference_audio/ via generate_references.py)
GOOGLE_TTS_API_KEY=

# Optional: Custom paths to cloned model repositories
SEED_VC_PATH=./seed-vc
EZ_VC_PATH=./EZ-VC
OMNIVOICE_PATH=./OmniVoice

# Optional: HuggingFace cache directory
HF_HUB_CACHE=./checkpoints
